## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options
.vs/
*.user
*.suo
*.cache
*.sln.docstates
*.userprefs

# Build results
bin/
obj/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local
appsettings.*.json
!appsettings.Development.json
!appsettings.json

# Node modules
node_modules/
npm-debug.log

# Database
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db
